# WhatsApp CTA: international format, digits only (e.g. 15551234567).
# Optional override: defaults to the real business number in src/config/site.ts
# (siteConfig.contact.phone) if unset. Set this only to use a different number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Set automatically by Vercel: used to gate indexing (robots/sitemap) and
# distinguish preview from production. Do not set manually outside Vercel.
# VERCEL_ENV=production

# Postgres (Prisma). Provision Postgres in the Vercel dashboard's Storage tab
# under the zaplio-devloper account; it sets these automatically. Locally,
# copy the same values into .env (never commit that file).
# POSTGRES_PRISMA_URL=        # pooled connection, used at runtime
# POSTGRES_URL_NON_POOLING=   # direct connection, used by `prisma migrate`

# Admin panel (/admin). Single shared password gating the posts/leads panel.
# ADMIN_PASSWORD=

# --- Not yet wired up (see TODOs in code) ---
# CRM/email delivery for /api/contact and /api/praxis-application submissions.
# CONTACT_WEBHOOK_URL=
# LLM provider key for the future /api/chat assistant (see plan section 18/22).
# ANTHROPIC_API_KEY=
